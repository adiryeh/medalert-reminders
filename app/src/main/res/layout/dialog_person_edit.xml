<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <EditText
        android:id="@+id/etPersonName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="שם (לדוגמה: אמא, ילד, אני)"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר צבע:"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Color palette: 8 circles in 2 rows of 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <View android:id="@+id/color0"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#2196F3"/>
        <View android:id="@+id/color1"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#4CAF50"/>
        <View android:id="@+id/color2"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#F44336"/>
        <View android:id="@+id/color3"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#FF9800"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View android:id="@+id/color4"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#9C27B0"/>
        <View android:id="@+id/color5"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#009688"/>
        <View android:id="@+id/color6"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#E91E63"/>
        <View android:id="@+id/color7"
            android:layout_width="0dp" android:layout_height="44dp"
            android:layout_weight="1" android:layout_margin="4dp"
            android:background="#795548"/>
    </LinearLayout>

    <!-- Preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="צבע נבחר: "
            android:textSize="13sp"/>
        <View
            android:id="@+id/selectedColorPreview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#2196F3"/>
    </LinearLayout>

</LinearLayout>
