<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 יומן התראות"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="חזור"
            android:textSize="13sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1565C0"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>

    <!-- Summary card -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvSummaryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvSummaryDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#555"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Legend toggle -->
    <TextView
        android:id="@+id/tvLegendToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ מקרא — מה כל סמל אומר (הצג)"
        android:textSize="13sp"
        android:textColor="#1565C0"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <!-- Legend content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F5F5F5"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:text="📡 אזעקה ראשית — מנגנון מקורי, בתוך האפליקציה. תמיד המקור הראשון שמנסה.\n\n🆘 רשת ביטחון — מנגנון גיבוי בתוך האפליקציה, בודק כל 15 דקות אם משהו הוחמץ.\n\n🔍 בדיקת רקע — לא התראה בעצמה! רק אישור שבדיקת ה-15 דקות רצה, גם אם לא מצאה כלום להתריע.\n\n📶 גיבוי חיצוני (FCM) — לא מנגנון של האפליקציה. שרת חיצוני (GitHub) ששולח דחיפה אם שני הקודמים נכשלו.\n\n🔔 התראה נשלחה — לא מקור בפני עצמו, רק אישור שההתראה בפועל הוצגה על המסך.\n\n✅ ❌ ⏰ — הפעולה שלך: נלקח / דולג / נדחה.\n\n⚠ 🛑 — שגיאה שכדאי לשים לב אליה."/>
    </androidx.cardview.widget.CardView>

    <!-- Log list -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="אירועים אחרונים (14 ימים):"
        android:textSize="13sp"
        android:textColor="#555"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAuditLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
